@page "/details/{Type}/{Id:int}"

@using AfterHours.Components.Shared
@using AfterHours.Data.Enum
@using AfterHours.Features.Media

@inject GetMediaDetails GetMediaDetails
@inject CreateMedia CreateMedia
@inject UpdateMedia UpdateMedia
@inject DeleteMedia DeleteMedia
@inject NavigationManager Nav

@if (details is null)
{
    <LoadingSpinner />
}
else
{
    <div class="min-h-screen bg-black">
        <div class="mx-auto max-w-6xl overflow-hidden rounded-xl bg-black">
            <Backdrop BackdropPath="@details.BackdropPath" Title="@details.Title" OnBack="HandleBack" />

            <div class="space-y-8 p-8">
                <Info Title="@details.Title" ReleaseDate="@details.ReleaseDate" Runtime="@details.Runtime"
                      Overview="@details.Overview" />

                <RatingSelector @bind-SelectedRating="selectedRating" @bind-SelectedRating:after="HandleRatingChanged" />

                <div class="flex items-center justify-between">
                    <StatusToggle @bind-SelectedStatus="selectedStatus" @bind-SelectedStatus:after="HandleStatusChanged" />

                    @if (details.IsSaved)
                    {
                        <DeleteButton OnDelete="HandleDelete" />
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string Type { get; set; } = string.Empty;

    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "from")]
    public string? From { get; set; }

    private GetDetailsResponse? details;
    private decimal? selectedRating;
    private MediaStatus? selectedStatus;

    protected override async Task OnParametersSetAsync()
    {
        if (Id == 0)
            return;

        await ReloadDetails();
    }

    private async Task ReloadDetails()
    {
        details = await GetMediaDetails.GetAsync(
            ParseMediaType(Type),
            Id);

        selectedRating = details?.Rating;
        selectedStatus = details?.MediaStatus;
    }

    private async Task HandleRatingChanged()
    {
        if (details is null)
            return;

        if (!details.IsSaved)
        {
            var request = new CreateMediaRequest(
                Id,
                selectedRating,
                details.Title ?? string.Empty,
                ParseMediaType(Type),
                details.PosterPath,
                MediaStatus.Planned);

            await CreateMedia.HandleAsync(request);
        }
        else if (details.Id is not null)
        {
            var request = new UpdateMediaRequest(
                selectedRating,
                details.MediaStatus ?? MediaStatus.Planned);

            await UpdateMedia.HandleAsync(details.Id.Value, request);
        }

        await ReloadDetails();
    }

    private async Task HandleStatusChanged()
    {
        if (details is null)
            return;

        if (!details.IsSaved)
        {
            if (selectedStatus is null) return;

            var request = new CreateMediaRequest(
                Id,
                selectedRating,
                details.Title ?? string.Empty,
                ParseMediaType(Type),
                details.PosterPath,
                selectedStatus.Value);

            await CreateMedia.HandleAsync(request);
        }
        else if (details.Id is not null)
        {
            var request = new UpdateMediaRequest(
                selectedRating,
                selectedStatus ?? MediaStatus.Planned);

            await UpdateMedia.HandleAsync(details.Id.Value, request);
        }

        await ReloadDetails();
    }

    private async Task HandleDelete()
    {
        if (details?.Id is null)
            return;

        await DeleteMedia.HandleAsync(details.Id.Value);
        Nav.NavigateTo("/library");
    }

    private static MediaType ParseMediaType(string type)
    {
        if (string.IsNullOrWhiteSpace(type))
        {
            throw new ArgumentException("media type is required.");
        }

        if (!Enum.TryParse<MediaType>(type, true, out var mediaType))
        {
            throw new ArgumentException("unknown media type.");
        }

        return mediaType;
    }

    private void HandleBack()
    {
        var target = From switch
        {
            "library" => "/library",
            _ => "/search"
        };

        Nav.NavigateTo(target);
    }
}