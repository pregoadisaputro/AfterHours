@page "/search"

@implements IDisposable

@using AfterHours.Components.Shared
@using AfterHours.Services.Tmdb
@using AfterHours.Services.Tmdb.Dto
@using AfterHours.Data.Enum

@inject NavigationManager Nav
@inject ITmdbService Tmdb

<div class="m-5 flex flex-col items-center justify-center gap-7">
    <input
    class="font-medium outline-none focus:ring-2 focus:ring-white mt-2 bg-[#121212] hover:bg-[#212121] border border-transparent hover:border-[#616161] transition-all duration-300 ease-in-out w-1/2 h-11 rounded-full px-6 py-2.5"
    @bind="query" @bind:event="oninput" @bind:after="OnQueryChanged" placeholder="search movie or show" />

    @if (isSearching)
    {
        <p>searching...</p>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p>@errorMessage</p>
    }

    @if (results is not null && results.Results.Count == 0)
    {
        <p>Not found.</p>
    }

    @if (results is not null && results.Results.Count > 0)
    {
        <div class="grid grid-cols-5 gap-1">
            @foreach (var item in results.Results)
            {
                <div @onclick="() => OpenMedia(item)">
                    <MediaCard Title="@(item.Title ?? item.Name)" ImageUrl="@item.Poster_Path" />
                </div>
            }
        </div>
    }
</div>

@code {
    private string query = string.Empty;
    private bool isSearching;
    private string? errorMessage;
    private TmdbSearchResponse? results;
    private CancellationTokenSource? debounce;

    private async Task OnQueryChanged()
    {
        debounce?.Cancel();
        debounce?.Dispose();

        debounce = new CancellationTokenSource();

        try
        {
            await Task.Delay(300, debounce.Token);
            await SearchAsync(debounce.Token);
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task SearchAsync(CancellationToken ct)
    {
        var currentQuery = query.Trim();

        if (string.IsNullOrWhiteSpace(currentQuery))
        {
            results = null;
            errorMessage = null;
            return;
        }

        isSearching = true;
        errorMessage = null;

        try
        {
            var response = await Tmdb.SearchAsync(currentQuery, ct: ct);

            if (currentQuery == query.Trim())
            {
                results = response;
            }
        }

        catch (OperationCanceledException)
        {

        }

        catch (Exception ex)
        {
            if (currentQuery == query.Trim())
            {
                errorMessage = ex.Message;
                results = null;
            }
        }
        finally
        {
            if (!ct.IsCancellationRequested)
            {
                isSearching = false;

            }
        }
    }

    public void Dispose()
    {
        debounce?.Cancel();
        debounce?.Dispose();
    }

    private void OpenMedia(TmdbSearchResults item)
    {

        var type = item.Media_Type switch
        {
            "movie" => MediaType.Movie,
            "tv" => MediaType.Tv,
            _ => MediaType.Movie
        };

        Nav.NavigateTo($"/details/{type}/{item.Id}");

    }
}