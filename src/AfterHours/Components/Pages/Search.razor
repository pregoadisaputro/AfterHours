@page "/search"

@implements IDisposable

@using AfterHours.Components.Shared
@using AfterHours.Services.Tmdb
@using AfterHours.Services.Tmdb.Dto
@using AfterHours.Data.Enum

@inject NavigationManager Nav
@inject TmdbService Tmdb

<div class="m-4 flex flex-col items-center justify-center gap-7">
    <input
    class="font-medium outline-none focus:ring-2 focus:ring-white mt-2 bg-[#121212] hover:bg-[#212121] border border-transparent hover:border-[#616161] transition-all duration-300 ease-in-out w-1/2 h-11 rounded-full px-6 py-2.5"
    @bind="query" @bind:event="oninput" @bind:after="HandleQueryChanged" placeholder="search movie or show" />

    @if (isSearching)
    {
        <p>searching...</p>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p>@errorMessage</p>
    }

    @if (results is not null)
    {
        @if (results.Results.Count == 0)
        {
            <div class="py-16 text-center">
                <p class="text-lg font-medium">no results found.</p>
                <p class="mt-2 text-sm text-neutral-500">
                    no movies or tv shows matched
                    "<span class="text-white">@query</span>".
                </p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-5 gap-1">
                @foreach (var item in results.Results)
                {
                    <button class="border-0 bg-transparent p-0 text-left" @onclick="() => HandleOpenMedia(item)">
                        <MediaCard Title="@(item.Title ?? item.Name)" ImageUrl="@item.PosterPath" />
                    </button>
                }
            </div>
        }
    }
</div>

@code {
    private string query = string.Empty;
    private bool isSearching;
    private string? errorMessage;
    private TmdbSearchResponse? results;
    private CancellationTokenSource? debounce;

    private async Task HandleQueryChanged()
    {
        debounce?.Cancel();
        debounce?.Dispose();

        debounce = new CancellationTokenSource();

        try
        {
            await Task.Delay(300, debounce.Token);
            await SearchAsync(debounce.Token);
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task SearchAsync(CancellationToken ct)
    {
        var currentQuery = query.Trim();

        if (string.IsNullOrWhiteSpace(currentQuery))
        {
            results = null;
            errorMessage = null;
            return;
        }

        isSearching = true;
        errorMessage = null;

        try
        {
            var response = await Tmdb.SearchAsync(currentQuery, ct: ct);

            if (currentQuery == query.Trim())
            {
                results = response;
            }
        }

        catch (OperationCanceledException)
        {

        }

        catch (Exception ex)
        {
            if (currentQuery == query.Trim())
            {
                errorMessage = ex.Message;
                results = null;
            }
        }
        finally
        {
            if (!ct.IsCancellationRequested)
            {
                isSearching = false;

            }
        }
    }

    private void HandleOpenMedia(TmdbSearchResults item)
    {

        var type = item.MediaType switch
        {
            "movie" => MediaType.Movie,
            "tv" => MediaType.Tv,
            _ => MediaType.Movie
        };

        Nav.NavigateTo($"/details/{type}/{item.Id}");

    }

    public void Dispose()
    {
        debounce?.Cancel();
        debounce?.Dispose();
    }
}