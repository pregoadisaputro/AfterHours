@page "/"

@inject NavigationManager Nav

<div class="flex flex-col gap-4 h-screen items-center justify-center">
    <h1 class="text-6xl font-semibold">welcome.</h1>

    <div class="flex gap-4">
        <button
        class="bg-white text-black cursor-pointer rounded-full px-4 py-2 font-medium transition duration-300 ease-in-out"
        @onclick="() => ToLibrary()">library</button>

        <button
        class="bg-white text-black cursor-pointer rounded-full px-4 py-2 font-medium transition duration-300 ease-in-out"
        @onclick="() => ToSearch()">search & add</button>
    </div>
</div>

@code {
    private void ToLibrary()
    {
        Nav.NavigateTo("/library");
    }

    private void ToSearch()
    {
        Nav.NavigateTo("/search");
    }
}