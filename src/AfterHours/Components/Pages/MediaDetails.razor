@page "/media/{Type}/{Id:int}"

@using AfterHours.Data.Enum
@using AfterHours.Features.Media.Dto
@using AfterHours.Features.Media.Services
@using AfterHours.Components.Shared

@inject IMediaService MediaService
@inject NavigationManager Nav


@if (details is null)
{
    <LoadingSpinner />
}
else
{
    <div class="min-h-screen bg-black">

        <div class="mx-auto max-w-6xl overflow-hidden rounded-xl bg-black">

            <Backdrop BackdropPath="@details.BackdropPath" Title="@details.Title" OnBack="GoBack" />

            <div class="space-y-8 p-8">

                <Info Title="@details.Title" ReleaseDate="@details.ReleaseDate" Runtime="@details.Runtime"
                      Overview="@details.Overview" />

                <RatingSelector SelectedRating="selectedRating" RatingSelected="SetRating" />

                <StatusToggle CurrentStatus="@details.MediaStatus" StatusSelected="SaveStatus" />

            </div>
        </div>
    </div>
}

@code {

    [Parameter]
    public string Type { get; set; } = string.Empty;
    [Parameter]
    public int Id { get; set; }

    private GetDetailsResponse? details;

    private decimal? selectedRating;

    protected override async Task OnParametersSetAsync()
    {
        if (Id == 0)
            return;

        await ReloadDetails();
    }

    private async Task ReloadDetails()
    {
        details = await MediaService.GetDetailsAsync(
            ParseMediaType(Type),
            Id);

        selectedRating = details?.Rating;
    }

    private async Task SetRating(decimal value)
    {
        selectedRating = value;

        if (details is null)
            return;

        if (details.IsSaved && details.Id is not null)
        {
            var request = new UpdateMediaRequest(
                selectedRating,
                details.MediaStatus ?? MediaStatus.Planned);

            await MediaService.UpdateAsync(
                details.Id.Value,
                request);

            await ReloadDetails();
        }
    }

    private async Task SaveStatus(MediaStatus status)
    {
        if (details is null)
            return;

        if (!details.IsSaved)
        {
            var request = new CreateMediaRequest(
                Id,
                selectedRating,
                details.Title ?? string.Empty,
                ParseMediaType(Type),
                details.PosterPath,
                details.BackdropPath,
                details.ReleaseDate,
                status);

            await MediaService.CreateAsync(request);
        }
        else
        {
            var request = new UpdateMediaRequest(
                selectedRating,
                status);

            await MediaService.UpdateAsync(
                details.Id!.Value,
                request);
        }

        await ReloadDetails();
    }

    private static MediaType ParseMediaType(string type)
    {
        if (string.IsNullOrWhiteSpace(type))
        {
            throw new ArgumentException("media type is required.");
        }

        return type.ToLower() switch
        {
            "movie" => MediaType.Movie,
            "tv" => MediaType.Tv,
            _ => throw new ArgumentException("unknown media type.")
        };
    }

    private void GoBack()
    {
        Nav.NavigateTo("/search");
    }
}