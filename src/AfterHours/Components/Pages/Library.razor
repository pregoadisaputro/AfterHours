@page "/library"

@implements IDisposable

@using AfterHours.Components.Shared
@using AfterHours.Data.Enum
@using AfterHours.Features.Media.Services
@using AfterHours.Features.Media.Dto

@inject MediaService MediaService
@inject NavigationManager Nav

<div class="m-4 flex flex-col items-center justify-center gap-7">
    <input
    class="font-medium outline-none focus:ring-2 focus:ring-white mt-2 bg-[#121212] hover:bg-[#212121] border border-transparent hover:border-[#616161] transition-all duration-300 ease-in-out w-1/2 h-11 rounded-full px-6 py-2.5"
    @bind="query" @bind:event="oninput" @bind:after="HandleQueryChanged" placeholder="search movie or show" />

    <div class="flex flex-wrap items-start justify-center gap-4">

        <div class="inline-flex gap-2 rounded-full bg-[#121212] p-1">
            <button class="cursor-pointer rounded-full px-4 py-2 font-medium transition duration-300 ease-in-out 
                @(mediaType is null ? "bg-white text-black" : "text-neutral-400 hover:text-white hover:bg-[#212121]")"
                    @onclick="() => SetMediaType(null)">
                all
            </button>
            <button
                class="cursor-pointer rounded-full px-4 py-2 font-medium transition duration-300 ease-in-out 
                @(mediaType == MediaType.Movie ? "bg-white text-black" : "text-neutral-400 hover:text-white hover:bg-[#212121]")"
                @onclick="() => SetMediaType(MediaType.Movie)">
                movie
            </button>
            <button
                class="cursor-pointer rounded-full px-4 py-2 font-medium transition duration-300 ease-in-out 
                @(mediaType == MediaType.Tv ? "bg-white text-black" : "text-neutral-400 hover:text-white hover:bg-[#212121]")"
                @onclick="() => SetMediaType(MediaType.Tv)">
                tv
            </button>
        </div>

        <div class="flex items-center gap-2">
            <StatusToggle CurrentStatus="mediaStatus" OnStatusChanged="HandleStatusChanged" />

            @if (mediaStatus.HasValue)
            {
                <button class="cursor-pointer text-xs text-neutral-500 hover:text-white underline"
                        @onclick="() => SetMediaStatus(null)">
                    clear
                </button>
            }
        </div>

        <div class="inline-flex gap-2 rounded-full bg-[#121212] p-1">
            <button
                class="cursor-pointer rounded-full px-4 py-2 font-medium transition duration-300 ease-in-out 
                @(sortBy == MediaSortBy.RecentlyAdded ? "bg-white text-black" : "text-neutral-400 hover:text-white hover:bg-[#212121]")"
                @onclick="() => SetSortBy(MediaSortBy.RecentlyAdded)">
                recently added
            </button>
            <button
                class="cursor-pointer rounded-full px-4 py-2 font-medium transition duration-300 ease-in-out 
                @(sortBy == MediaSortBy.RecentlyUpdated ? "bg-white text-black" : "text-neutral-400 hover:text-white hover:bg-[#212121]")"
                @onclick="() => SetSortBy(MediaSortBy.RecentlyUpdated)">
                recently updated
            </button>
        </div>
    </div>

    <div class="flex flex-col items-center gap-2">
        <RatingFilter SelectedRating="selectedRating" OnRatingChanged="HandleRatingChanged" />

        @if (selectedRating.HasValue)
        {
            <button class="cursor-pointer text-xs text-neutral-500 hover:text-white underline"
                    @onclick="() => SetRating(null)">
                clear rating
            </button>
        }
    </div>

    @if (isSearching)
    {
        <p>searching...</p>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p>@errorMessage</p>
    }

    @if (response is not null && response.Data.Count == 0)
    {
        <p class="font-medium text-lg">no media saved yet.</p>
    }

    @if (response is not null && response.Data.Count > 0)
    {
        <div class="grid grid-cols-6 gap-1">
            @foreach (var item in response.Data)
            {
                <button class="border-0 bg-transparent p-0 text-left" @onclick="() => OpenMedia(item)">
                    <MediaCard Title="@item.Title" Rating="@item.Rating" ImageUrl="@item.PosterPath" />
                </button>
            }
        </div>

        <div class="flex gap-4 items-center">
            <button
                class="font-medium cursor-pointer disabled:cursor-not-allowed px-4 py-2 rounded-full bg-[#121212] hover:bg-[#212121] disabled:opacity-40 disabled:hover:bg-[#121212]"
                disabled="@(!GoBack)" @onclick="GoToPreviousPage">
                prev
            </button>

            <span class="text-sm font-medium text-neutral-400">
                page @currentPage of @response.TotalPages
            </span>

            <button
                class="font-medium cursor-pointer disabled:cursor-not-allowed  px-4 py-2 rounded-full bg-[#121212] hover:bg-[#212121] disabled:opacity-40 disabled:hover:bg-[#121212]"
                disabled="@(!GoNext)" @onclick="GoToNextPage">
                next
            </button>
        </div>
    }
</div>

@code {
    private GetMediasPage? response;
    private int currentPage = 1;
    private int pageSize = 24;
    private string query = string.Empty;
    private decimal? selectedRating;
    private MediaType? mediaType;
    private MediaStatus? mediaStatus;
    private MediaSortBy sortBy = MediaSortBy.RecentlyAdded;
    private bool isSearching;
    private string? errorMessage;
    private CancellationTokenSource? debounce;

    private bool GoBack => currentPage > 1;
    private bool GoNext => response is not null && currentPage < response.TotalPages;

    protected override async Task OnInitializedAsync()
    {
        await LoadPage();
    }

    private async Task HandleQueryChanged()
    {
        debounce?.Cancel();
        debounce?.Dispose();

        debounce = new CancellationTokenSource();

        try
        {
            await Task.Delay(300, debounce.Token);
            currentPage = 1;
            await LoadPage(debounce.Token);
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task SetMediaType(MediaType? value)
    {
        mediaType = value;
        await HandleFiltersChanged();
    }

    private async Task SetSortBy(MediaSortBy value)
    {
        sortBy = value;
        await HandleFiltersChanged();
    }

    private async Task HandleStatusChanged(MediaStatus value)
    {
        mediaStatus = mediaStatus == value ? null : value;
        await HandleFiltersChanged();
    }

    private async Task SetMediaStatus(MediaStatus? value)
    {
        mediaStatus = value;
        await HandleFiltersChanged();
    }

    private async Task HandleRatingChanged(decimal value)
    {
        selectedRating = selectedRating == value ? null : value;
        await HandleFiltersChanged();
    }

    private async Task SetRating(decimal? value)
    {
        selectedRating = value;
        await HandleFiltersChanged();
    }

    private async Task HandleFiltersChanged()
    {
        currentPage = 1;
        await LoadPage();
    }

    private async Task LoadPage(CancellationToken ct = default)
    {
        isSearching = true;
        errorMessage = null;

        var currentQuery = query.Trim();

        try
        {
            var data = new GetMediasRequest(
                currentPage,
                pageSize,
                currentQuery,
                selectedRating,
                mediaType,
                mediaStatus,
                sortBy
            );

            var result = await MediaService.GetMediasAsync(data, ct);

            if (currentQuery == query.Trim())
            {
                response = result;
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            if (currentQuery == query.Trim())
            {
                errorMessage = ex.Message;
                response = null;
            }
        }
        finally
        {
            if (!ct.IsCancellationRequested)
            {
                isSearching = false;
            }
        }
    }

    private async Task GoToPreviousPage()
    {
        if (!GoBack)
        {
            return;
        }

        currentPage--;
        await LoadPage();
    }

    private async Task GoToNextPage()
    {
        if (!GoNext)
        {
            return;
        }

        currentPage++;
        await LoadPage();
    }

    private void OpenMedia(GetMediasResponse item)
    {

        Nav.NavigateTo($"/details/{item.MediaType}/{item.ExternalId}");
    }

    public void Dispose()
    {
        debounce?.Cancel();
        debounce?.Dispose();
    }
}