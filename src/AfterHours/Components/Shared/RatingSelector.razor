<div>

    <p class="text-5xl font-medium text-neutral-300">
        @(SelectedRating?.ToString("0") ?? "0")
    </p>

    <p class="mb-3 text-xs font-medium text-neutral-500">
        your rating
    </p>

    <div class="flex gap-1">

        @for (var i = 1; i <= 10; i++)
        {
            var value = i;

            <button class="
                cursor-pointer
                text-4xl
                transition
                duration-300
                ease-in-out
                hover:scale-110 @(SelectedRating >= value ? "text-white" : "text-neutral-600 hover:text-white")"
                    @onclick="() => OnRatingChanged.InvokeAsync(value)">
                ✪
            </button>
        }
    </div>
</div>

@code {

    [Parameter]
    public decimal? SelectedRating { get; set; }

    [Parameter]
    public EventCallback<decimal> OnRatingChanged { get; set; }
}