@if (Details is null)
{
    <p class="text-center">cannot load the details</p>
}
else
{
    <div>
        @if (!string.IsNullOrWhiteSpace(Details.Title))
        {
            <h1 class="text-4xl font-bold">
                @Details.Title
            </h1>
        }
        <div class="mt-3 flex items-center gap-2 text-sm text-neutral-400">
            @if (Details.ReleaseDate.HasValue)
            {
                <span>
                    @Details.ReleaseDate
                </span>
            }
            @if (Details.Runtime.HasValue)
            {
                <span>•</span>
                <span>@FormatRuntime(Details.Runtime)</span>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Details.Overview))
    {
        <p class="max-w-3xl text-sm leading-relaxed text-neutral-400">
            @Details.Overview
        </p>
    }
}

@code {
    [Parameter] public GetDetailsResponse? Details { get; set; }

    private static string FormatRuntime(int? runtime)
    {
        if (runtime is null)
            return string.Empty;

        var hours = runtime.Value / 60;
        var minutes = runtime.Value % 60;

        if (hours > 0 && minutes > 0)
            return $"{hours}h {minutes}m";

        if (hours > 0)
            return $"{hours}h";

        return $"{minutes}m";
    }
}