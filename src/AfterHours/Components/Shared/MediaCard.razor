<div
    class="flex flex-col h-full p-1.5 cursor-pointer rounded-[14px] hover:bg-[#212121] transition duration-300 ease-in-out">
    @if (!string.IsNullOrEmpty(ImageUrl))
    {
        <img class="w-full border-2 border-[#212121] aspect-2/3 object-cover rounded-lg"
             src="@($"https://image.tmdb.org/t/p/w500{ImageUrl}")" alt="@Title">

    }

    <div class="flex flex-col flex-1 mt-2 gap-2">
        @if (!String.IsNullOrEmpty(Title))
        {
            <p class="font-bold line-clamp-2">@Title</p>
        }

        @if (!string.IsNullOrEmpty(ReleaseDate))
        {
            <p class="text-sm text-gray-500 mt-auto">@ReleaseDate</p>
        }
    </div>

</div>


@code {
    [Parameter]
    public string? Title { get; set; }
    [Parameter]
    public string? ImageUrl { get; set; }
    [Parameter]
    public string? ReleaseDate { get; set; }
}