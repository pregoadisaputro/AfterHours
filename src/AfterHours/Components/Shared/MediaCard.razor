<div
    class="flex flex-col h-full p-1.5 cursor-pointer rounded-[20px] hover:bg-[#212121] transition duration-300 ease-in-out">
    @if (!string.IsNullOrEmpty(ImageUrl))
    {
        <img class="w-full border-2 border-[#212121] aspect-2/3 object-cover rounded-[14px]"
             src="@($"https://image.tmdb.org/t/p/w500{ImageUrl}")" alt="@Title">
    }
</div>

@code {
    [Parameter]
    public string? Title { get; set; }
    [Parameter]
    public string? ImageUrl { get; set; }
}