<div class="flex flex-col gap-1">
    <p class="text-center text-xs font-medium text-neutral-500">
        filter by rating
    </p>

    <div class="flex gap-1">

        @for (var i = 1; i <= 10; i++)
        {
            var value = (decimal)i;

            <button class="
                cursor-pointer
                text-4xl
                transition
                duration-300
                ease-in-out
                hover:scale-110 @(SelectedRating >= value ? "text-white" : "text-neutral-600 hover:text-white")"
                    @onclick="() => ToggleRating(value)">
                ✪
            </button>
        }
    </div>
</div>

@code {

    [Parameter]
    public decimal? SelectedRating { get; set; }

    [Parameter]
    public EventCallback<decimal?> SelectedRatingChanged { get; set; }

    private Task ToggleRating(decimal value)
    {
        decimal? newRating = SelectedRating == value ? null : value;

        return SelectedRatingChanged.InvokeAsync(newRating);
    }

}