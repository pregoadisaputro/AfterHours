@using AfterHours.Data.Enum

<div class="inline-flex gap-2 rounded-full bg-[#121212] p-1">

    @foreach (var option in Enum.GetValues<MediaStatus>())
    {
        <button type="button" class="
            cursor-pointer
            rounded-full
            px-4
            py-2
            font-medium
            transition
            duration-300
            ease-in-out
            @(SelectedStatus == option
    ? "bg-white text-black"
    : "text-neutral-400 hover:text-white hover:bg-[#212121]")" @onclick="() => ToggleStatus(option)">
            @option.ToString().ToLower()
        </button>
    }
</div>

@code {

    [Parameter]
    public MediaStatus? SelectedStatus { get; set; }

    [Parameter]
    public EventCallback<MediaStatus?> SelectedStatusChanged { get; set; }

    private Task ToggleStatus(MediaStatus value)
    {
        MediaStatus? newStatus = SelectedStatus == value ? null : value;

        return SelectedStatusChanged.InvokeAsync(newStatus);
    }
}